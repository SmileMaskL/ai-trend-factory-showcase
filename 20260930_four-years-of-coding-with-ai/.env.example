TELEGRAM_CHAT_ID=      # 다이제스트를 받을 채팅/채널 ID

# 선택 (없어도 동작함)
GITHUB_TOKEN=          # 선택: GitHub 개인 토큰. 비인증 한도(시간당 60회)를 넘길 만큼 저장소가 많을 때만 필요
RADAR_LOOKBACK_DAYS=7  # 최초 실행 시 포함할 릴리스 기간(일)
RADAR_HN_WINDOW_HOURS=36   # HN 검색 기간(시간)
RADAR_HN_MIN_POINTS=30     # HN 최소 점수
RADAR_HN_MAX_ITEMS=8       # HN 최대 항목 수
RADAR_SEND_EMPTY=0         # 1이면 새 소식이 없는 날에도 알림 전송